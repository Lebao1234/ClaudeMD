{
  "enabledPlugins": {
    "epod@epodsystem-cli": true
  },
  "permissions": {
    "allow": [
      "Bash(node tools/build.js)",
      "Bash(node tools/check.js)",
      "Bash(node tools/make-svg.js)",
      "Bash(node tools/smoke-test.js)",
      "Bash(node .agents/skills/web-anti-ai-lint/scripts/lint.js *)",
      "Bash(node .agents/skills/web-rotation/scripts/next-combo.js *)",
      "Bash(node .agents/skills/web-rotation/scripts/register.js *)",
      "Bash(node .agents/skills/web-project-scaffold/scripts/ensure-mcp.js *)",
      "Bash(node .agents/skills/web-qa/scripts/*)",
      "Bash(node .agents/skills/web-epod-deploy/scripts/epod.js * export)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.js\"",
            "timeout": 20,
            "statusMessage": "Kiểm luật repo (token, website/, HTML build)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/rebuild.js\"",
            "timeout": 90,
            "statusMessage": "Build + check site vừa sửa"
          }
        ]
      }
    ]
  }
}
